---
import Layout from '../layouts/Layout.astro';
import '../styles/v4.css';
---

<Layout title="InventaFactura — Facturación e inventario en móvil y PC">
  <!-- Ambient background -->
  <div class="ambient" aria-hidden="true">
    <div class="orb orb-a"></div>
    <div class="orb orb-b"></div>
    <div class="grid-overlay"></div>
  </div>

  <!-- ===== Header ===== -->
  <header class="site-header" id="header">
    <div class="container header-inner">
      <a class="brand" href="#inicio">
        <span class="brand-logo" role="img" aria-label="InventaFactura"></span>
        <span class="brand-name">InventaFactura</span>
      </a>
      <nav class="main-nav" aria-label="Principal">
        <a href="#producto" data-i18n="nav.benefits">Beneficios</a>
        <a href="#flujo" data-i18n="nav.how">Cómo funciona</a>
        <a href="#disponibilidad" data-i18n="nav.avail">Disponibilidad</a>
        <a href="#faq" data-i18n="nav.faq">FAQ</a>
      </nav>
      <div class="header-actions">
        <button class="lang-toggle" id="langToggle" aria-label="Cambiar idioma"><span id="langLabel">EN</span></button>
        <button class="theme-toggle" id="themeToggle" aria-label="Cambiar tema" aria-pressed="false">
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        </button>
        <a class="btn btn-primary btn-sm" href="#disponibilidad" data-i18n="cta.demo">Ver disponibilidad</a>
        <button class="menu-toggle" id="menuToggle" aria-label="Menú" aria-expanded="false">
          <span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <main id="inicio">
    <!-- ===== Hero ===== -->
    <section class="hero">
      <div class="container">
        <div class="hero-inner">
          <span class="hero-badge">
            <span class="badge-dot"></span>
            <span data-i18n="v4.hero.badge">Facturación e inventario</span>
          </span>
          <h1 class="hero-title">
            <span class="hero-line" data-i18n="v4.hero.title1">Factura, controla tu stock</span>
            <span class="hero-line gradient-text" data-i18n="v4.hero.title2">y gestiona clientes.</span>
          </h1>
          <p class="hero-sub" data-i18n="v4.hero.sub">Una sola herramienta para emitir documentos, mantener tu inventario al día y facturar más rápido. En tu móvil y en tu PC.</p>
          <div class="hero-ctas">
            <a class="btn btn-primary btn-lg" href="#disponibilidad" data-i18n="cta.pc">Probar en PC</a>
            <a class="btn btn-ghost btn-lg" href="#disponibilidad" data-i18n="cta.mobile">Probar en Móvil</a>
          </div>
          <p class="hero-note" data-i18n="v4.hero.note">Disponible como app nativa en Android e iOS y en tu navegador.</p>
        </div>

        <!-- Browser mockup with mini real UI -->
        <div class="browser-scene" data-reveal>
          <div class="browser-window" id="browserWindow">
          <div class="browser-bar">
            <span class="traffic"><i></i><i></i><i></i></span>
            <span class="browser-url">inventafactura.com/panel</span>
          </div>
          <div class="app-ui">
            <aside class="ui-sidebar">
              <div class="ui-logo"><span class="ui-logo-mark">IF</span></div>
              <nav class="ui-nav">
                <span class="ui-nav-item is-active"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>Panel</span>
                <span class="ui-nav-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>Documentos</span>
                <span class="ui-nav-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg>Inventario</span>
                <span class="ui-nav-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>Clientes</span>
              </nav>
            </aside>
            <div class="ui-main">
              <div class="ui-topbar">
                <span class="ui-title">Documentos recientes</span>
                <span class="ui-chip">Factura</span>
              </div>
              <table class="ui-table">
                <thead><tr><th>Documento</th><th>Cliente</th><th>Estado</th><th>Total</th></tr></thead>
                <tbody>
                  <tr>
                    <td><span class="td-strong">F001-2451</span></td>
                    <td>Comercial Andina</td>
                    <td><span class="pill pill-ok">Emitido</span></td>
                    <td class="td-strong">S/ 1,240.00</td>
                  </tr>
                  <tr>
                    <td><span class="td-strong">B002-1098</span></td>
                    <td>Bodega El Sol</td>
                    <td><span class="pill pill-ok">Emitido</span></td>
                    <td class="td-strong">S/ 320.50</td>
                  </tr>
                  <tr>
                    <td><span class="td-strong">F001-2452</span></td>
                    <td>Textil Norte S.A.C.</td>
                    <td><span class="pill pill-warn">En proceso</span></td>
                    <td class="td-strong">S/ 2,860.00</td>
                  </tr>
                  <tr>
                    <td><span class="td-strong">G001-0033</span></td>
                    <td>Distribuidora Lima</td>
                    <td><span class="pill pill-ok">Emitido</span></td>
                    <td class="td-strong">—</td>
                  </tr>
                </tbody>
              </table>
              <div class="ui-stats">
                <div class="ui-stat"><span class="ui-stat-num">+12%</span><span class="ui-stat-label">Ventas del mes</span></div>
                <div class="ui-stat"><span class="ui-stat-num">48</span><span class="ui-stat-label">Docs. emitidos</span></div>
                <div class="ui-stat"><span class="ui-stat-num">S/ 9,400</span><span class="ui-stat-label">Facturado</span></div>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- ===== Trust strip ===== -->
    <section class="trust">
      <div class="container">
        <p class="trust-label" data-i18n="v4.trust.label">Construido para negocios como el tuyo</p>
      </div>
    </section>

    <!-- ===== Bento features ===== -->
    <section class="features" id="producto">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow" data-i18n="v4.features.eyebrow">El sistema</span>
          <h2 class="section-title" data-i18n="v4.features.title">Todo lo que tu negocio necesita, en un panel</h2>
          <p class="section-sub" data-i18n="v4.features.sub">Seis documentos soportados, inventario sincronizado y tus clientes siempre a la mano.</p>
        </div>

        <div class="bento" data-reveal>
          <article class="bento-card card-big">
            <i class="plateau" aria-hidden="true"></i>
            <div class="card-copy">
              <span class="card-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
              <h3 data-i18n="v4.f1.title">Documentos en segundos</h3>
              <p data-i18n="v4.f1.desc">Factura, Boleta, Nota de Crédito, Nota de Débito, Guía de Remisión y Guía Transportista: crea y guarda al instante.</p>
            </div>
            <div class="mini-stack" aria-hidden="true">
              <div class="mini-doc d1"><span>F</span><i></i><i></i><i></i></div>
              <div class="mini-doc d2"><span>B</span><i></i><i></i></div>
              <div class="mini-doc d3"><span>NC</span><i></i><i></i><i></i></div>
            </div>
          </article>

          <article class="bento-card">
            <i class="plateau" aria-hidden="true"></i>
            <div class="card-copy">
              <span class="card-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg></span>
              <h3 data-i18n="v4.f2.title">Inventario sincronizado</h3>
              <p data-i18n="v4.f2.desc">Vendes y el stock se actualiza solo, en tiempo real.</p>
            </div>
            <div class="mini-meter" aria-hidden="true"><i class="m1"></i><i class="m2"></i><i class="m3"></i><i class="m4"></i></div>
          </article>

          <article class="bento-card">
            <i class="plateau" aria-hidden="true"></i>
            <div class="card-copy">
              <span class="card-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg></span>
              <h3 data-i18n="v4.f3.title">Clientes a la mano</h3>
              <p data-i18n="v4.f3.desc">Sus datos guardados, listos para el siguiente documento.</p>
            </div>
            <div class="mini-chips" aria-hidden="true"><i>Juan P.</i><i>María G.</i><i>Carlos R.</i></div>
          </article>

          <article class="bento-card">
            <i class="plateau" aria-hidden="true"></i>
            <div class="card-copy">
              <span class="card-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg></span>
              <h3 data-i18n="v4.f4.title">Móvil y PC</h3>
              <p data-i18n="v4.f4.desc">La misma cuenta en tu teléfono y tu computadora, sincronizada.</p>
            </div>
            <div class="mini-devices" aria-hidden="true">
              <span class="mini-phone"></span>
              <span class="mini-laptop"></span>
            </div>
          </article>

          <article class="bento-card card-big">
            <i class="plateau" aria-hidden="true"></i>
            <div class="card-copy">
              <span class="card-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></span>
              <h3 data-i18n="v4.f5.title">Sin papeles ni plantillas</h3>
              <p data-i18n="v4.f5.desc">Adiós a las plantillas sueltas y al balanceo de fin de mes: todo el flujo de documentos vive en un solo lugar.</p>
            </div>
            <div class="mini-table" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div>
          </article>

          <article class="bento-card">
            <i class="plateau" aria-hidden="true"></i>
            <div class="card-copy">
              <span class="card-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg></span>
              <h3 data-i18n="v4.f6.title">Rápido de adoptar</h3>
              <p data-i18n="v4.f6.desc">Sin configuraciones complicadas. Crea tu cuenta y emite tu primer documento hoy.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== Flow ===== -->
    <section class="flow" id="flujo">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow" data-i18n="v4.flow.eyebrow">Cómo funciona</span>
          <h2 class="section-title" data-i18n="v4.flow.title">Un flujo simple, de principio a fin</h2>
        </div>
        <div class="flow-track" aria-hidden="true"><span class="flow-line"></span></div>
        <div class="flow-steps" data-reveal>
          <article class="flow-step" data-step="1">
            <i class="plateau" aria-hidden="true"></i>
            <span class="step-num">01</span>
            <h3 data-i18n="v4.flow.s1.title">Crea tu cuenta</h3>
            <p data-i18n="v4.flow.s1.desc">Regístrate en segundos con tu correo.</p>
          </article>
          <article class="flow-step" data-step="2">
            <i class="plateau" aria-hidden="true"></i>
            <span class="step-num">02</span>
            <h3 data-i18n="v4.flow.s2.title">Emite tu primer documento</h3>
            <p data-i18n="v4.flow.s2.desc">Factura, boleta, nota o guía: listo en segundos.</p>
          </article>
          <article class="flow-step" data-step="3">
            <i class="plateau" aria-hidden="true"></i>
            <span class="step-num">03</span>
            <h3 data-i18n="v4.flow.s3.title">El stock se actualiza solo</h3>
            <p data-i18n="v4.flow.s3.desc">Tu inventario y clientes quedan al día sin tocar nada.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== Problem / Solution ===== -->
    <section class="pas">
      <div class="container pas-grid" data-reveal>
        <article class="pas-block pas-problem">
          <i class="plateau" aria-hidden="true"></i>
          <span class="eyebrow" data-i18n="v4.problem.eyebrow">El problema</span>
          <h2 data-i18n="v4.problem.title">La facturación todavía te cuesta horas.</h2>
          <p data-i18n="v4.problem.desc">Plantillas por aquí, stock que se desactualiza, datos de clientes que hay que tipear una y otra vez. Y a fin de mes, el balanceo empieza de nuevo.</p>
        </article>
        <article class="pas-block pas-solution">
          <i class="plateau" aria-hidden="true"></i>
          <span class="eyebrow" data-i18n="v4.solution.eyebrow">La solución</span>
          <h2 data-i18n="v4.solution.title">Con InventaFactura, cada documento nace en segundos.</h2>
          <p data-i18n="v4.solution.desc">Tu inventario se actualiza solo y tus clientes están a un toque. Tú diriges el negocio; nosotros ponemos el orden.</p>
        </article>
      </div>
    </section>

    <!-- ===== Availability ===== -->
    <section class="avail" id="disponibilidad">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow" data-i18n="avail.eyebrow">Disponibilidad</span>
          <h2 class="section-title" data-i18n="avail.title">En tu móvil y en tu PC</h2>
          <p class="section-sub" data-i18n="avail.sub">El mismo sistema, donde lo necesites.</p>
        </div>
        <div class="avail-grid" data-reveal>
          <article class="avail-card">
            <i class="plateau" aria-hidden="true"></i>
            <span class="card-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg></span>
            <h3 data-i18n="v4.avail.mobile.title">Móvil</h3>
            <p data-i18n="v4.avail.mobile.desc">Apps nativas para Android e iOS desde las tiendas oficiales. Tu sistema en el bolsillo.</p>
            <a class="btn btn-ghost" href="#disponibilidad" data-i18n="cta.mobile">Probar en Móvil</a>
          </article>
          <article class="avail-card">
            <i class="plateau" aria-hidden="true"></i>
            <span class="card-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg></span>
            <h3 data-i18n="v4.avail.pc.title">PC — Web</h3>
            <p data-i18n="v4.avail.pc.desc">Abre tu navegador y listo. Sin instalaciones, sin configuraciones.</p>
            <a class="btn btn-ghost" href="#disponibilidad" data-i18n="cta.pc">Probar en PC</a>
          </article>
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="faq" id="faq">
      <div class="container faq-inner">
        <h2 class="section-title" data-i18n="faq.title">Preguntas frecuentes</h2>
        <div class="faq-list" data-reveal>
          <details class="faq-item">
            <summary><span data-i18n="faq.q1">¿Está disponible en PC y móvil?</span><span class="faq-chev"></span></summary>
            <p data-i18n="faq.a1">Sí. Funciona como app nativa en Android e iOS y como web app en tu PC, sin instalar nada.</p>
          </details>
          <details class="faq-item">
            <summary><span data-i18n="faq.q2">¿Necesito instalar algo en mi PC?</span><span class="faq-chev"></span></summary>
            <p data-i18n="faq.a2">No. En tu PC solo abre el navegador y usa el sistema directamente.</p>
          </details>
          <details class="faq-item">
            <summary><span data-i18n="faq.q3">¿Para quién es InventaFactura?</span><span class="faq-chev"></span></summary>
            <p data-i18n="faq.a3">Ideal para pymes, tiendas y negocios que necesitan facturar y llevar su inventario de forma simple.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- ===== Final CTA ===== -->
    <section class="final">
      <div class="container final-inner" data-reveal>
        <i class="plateau" aria-hidden="true"></i>
        <h2 class="final-title" data-i18n="v4.final.title">Tu negocio, en orden.</h2>
        <p class="final-sub" data-i18n="v4.final.sub">Facturación e inventario en una sola herramienta. Escríbenos y empieza hoy.</p>
        <a class="btn btn-primary btn-lg" href="#disponibilidad" data-i18n="v4.final.cta">Probar ahora</a>
      </div>
    </section>
  </main>

  <!-- ===== Footer ===== -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <a class="brand" href="#inicio">
            <span class="brand-logo" role="img" aria-label="InventaFactura"></span>
            <span class="brand-name">InventaFactura</span>
          </a>
          <p class="footer-tag" data-i18n="footer.tag">Sistema de facturación e inventario para móvil y PC.</p>
          <div class="footer-social">
            <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
            <a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
            <a href="#" aria-label="X"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l16 16M20 4L4 20"/></svg></a>
          </div>
        </div>
        <div class="footer-col">
          <h4 data-i18n="footer.product">Producto</h4>
          <div class="footer-links">
            <a href="#producto" data-i18n="footer.docs">Documentos</a>
            <a href="#disponibilidad" data-i18n="footer.avail">Disponibilidad</a>
            <a href="#faq" data-i18n="nav.faq">FAQ</a>
          </div>
        </div>
        <div class="footer-col">
          <h4 data-i18n="footer.legal">Legal</h4>
          <div class="footer-links">
            <a href="#" data-i18n="footer.terms">Términos de uso</a>
            <a href="#" data-i18n="footer.privacy">Privacidad</a>
            <a href="#" data-i18n="footer.contact">Contacto</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="footer-rights">© {new Date().getFullYear()} InventaFactura — <span data-i18n="footer.rights">Todos los derechos reservados.</span></p>
        <p class="footer-rights">Hecho con <a href="https://astro.build" target="_blank" rel="noopener" class="footer-heart">Astro</a></p>
      </div>
    </div>
  </footer>
</Layout>

<script>
  import { initI18n } from '../scripts/i18n';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Header: scroll state ---------- */
  const header = document.getElementById('header');
  function onScrollHeader() {
    if (window.scrollY > 8) header.classList.add('is-scrolled');
    else header.classList.remove('is-scrolled');
  }
  window.addEventListener('scroll', onScrollHeader, { passive: true });
  onScrollHeader();

  /* ---------- Mobile menu ---------- */
  const menuToggle = document.getElementById('menuToggle');
  const mainNav = document.querySelector('.main-nav');
  if (menuToggle && mainNav) {
    menuToggle.addEventListener('click', () => {
      const open = mainNav.classList.toggle('is-open');
      menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    mainNav.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        mainNav.classList.remove('is-open');
        menuToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  /* ---------- Sticky header reset on anchors ---------- */
  document.querySelectorAll('a[href^="#"]').forEach((a) => {
    a.addEventListener('click', () => {
      if (mainNav) mainNav.classList.remove('is-open');
    });
  });

  /* ---------- Reveal on scroll ---------- */
  const revealEls = document.querySelectorAll('[data-reveal]');
  if ('IntersectionObserver' in window && !prefersReducedMotion) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  }

  /* ---------- Tilt en tarjetas bento (mouse) ---------- */
  if (!prefersReducedMotion && window.matchMedia('(hover: hover)').matches) {
    document.querySelectorAll('.bento-card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', ((e.clientX - r.left) / r.width) * 100 + '%');
        card.style.setProperty('--my', ((e.clientY - r.top) / r.height) * 100 + '%');
      });
    });
  }

  /* ---------- Theme toggle ---------- */
  const themeToggle = document.getElementById('themeToggle');
  const THEME_KEY = 'inventafactura-theme';
  if (themeToggle) {
    const syncIcon = () => {
      const dark = document.documentElement.getAttribute('data-theme') === 'dark';
      themeToggle.setAttribute('aria-pressed', dark ? 'true' : 'false');
    };
    themeToggle.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem(THEME_KEY, next); } catch (e) { /* noop */ }
      syncIcon();
    });
    syncIcon();
  }

  /* ---------- Init i18n ---------- */
  initI18n();
</script>
